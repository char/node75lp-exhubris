interface node75-keyboard

struct LightingState {
    field keys "[u16; 6]"
    field now u32
    field active bool
    field leds u8
    field touching bool
}

method set_matrix {
    doc "Board task: the debounced matrix, whenever it changes and at least every 100 ms."
    operation 0
    arg keys "[u16; 6]"
    auto-retry
}

method media_key {
    doc "Touch task: the consumer usage now held, or 0. False if USB dropped it."
    operation 1
    arg usage u16
    result bool
    auto-retry
}

method set_contact {
    operation 2
    arg touching bool
    auto-retry
}

method lighting_state {
    operation 3
    result LightingState
    auto-retry
}
