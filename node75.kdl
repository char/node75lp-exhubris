app node75
board "proj:board.kdl"

kernel {
    workspace-crate node75-kernel
    stack-size 4096
}

task keyboard {
    workspace-crate node75-keyboard
    stack-size 4096
    priority 0
    uses-peripheral trusted-board-io
    uses-task board
    uses-task lighting
    uses-task touch
}

task board {
    workspace-crate node75-board
    stack-size 2048
    priority 1
    uses-peripheral trusted-board-io
    uses-task keyboard
    uses-task touch
    uses-task lighting
}

task lighting {
    workspace-crate node75-lighting
    stack-size 2048
    priority 3
    uses-peripheral trusted-board-io
    uses-task keyboard
    uses-task board
}

task touch {
    workspace-crate node75-touch
    stack-size 2048
    priority 2
    uses-task keyboard
    uses-task board
}

task idle {
    workspace-crate node75-idle
    stack-size 256
    priority 255
}
