@@ -0,0 +1,80 @@
+OUTPUT_ARCH(riscv)
+ENTRY(_start)
+INCLUDE memory.x
+
+SECTIONS {
+    .init : {
+        KEEP(*(.init))
+    } > VECTORS
+
+    .vectors : {
+        _vectors_start = .;
+        KEEP(*(.vectors))
+        _vectors_end = .;
+    } > RECOVERY AT> VECTORS
+    _vectors_load = LOADADDR(.vectors);
+
+    .ramtext : ALIGN(4) {
+        _ramtext_start = .;
+        *(.ramtext .ramtext.*)
+        . = ALIGN(4);
+        _ramtext_end = .;
+    } > RECOVERY AT> VECTORS
+    _ramtext_load = LOADADDR(.ramtext);
+
+    .header : ALIGN(4) {
+        HEADER = .;
+        . += _HUBRIS_IMAGE_HEADER_SIZE;
+    } > VECTORS
+
+    .text : ALIGN(4) {
+        *(.text .text.*)
+        *(.rodata .rodata.*)
+        KEEP(*(.hubris_id))
+        . = ALIGN(4);
+    } > FLASH
+
+    .data : ALIGN(4) {
+        _data_start = .;
+        *(.sdata .sdata.* .data .data.*)
+        . = ALIGN(4);
+        _data_end = .;
+    } > RAM AT> FLASH
+    _data_load = LOADADDR(.data);
+    __global_pointer$ = _data_start + 0x800;
+
+    .bss (NOLOAD) : ALIGN(4) {
+        _bss_start = .;
+        *(.sbss .sbss.* .bss .bss.*)
+        *(COMMON)
+        . = ALIGN(4);
+        _bss_end = .;
+    } > RAM
+
+    .uninit (NOLOAD) : ALIGN(4) {
+        *(.uninit .uninit.*)
+        . = ALIGN(4);
+    } > RAM
+
+    .stack (NOLOAD) : ALIGN(16) {
+        _stack_bottom = .;
+        . = ORIGIN(STACK) + LENGTH(STACK);
+        _stack_top = .;
+    } > STACK
+
+    /DISCARD/ : { *(.eh_frame*) }
+}
+
+ASSERT(ORIGIN(VECTORS) == 0x13000, "application origin changed");
+ASSERT(SIZEOF(.init) == 4, "image must begin with a four-byte jump");
+ASSERT(LOADADDR(.vectors) == ORIGIN(VECTORS) + 4, "stock vector image offset changed");
+ASSERT(SIZEOF(.vectors) == 36 * 4, "unexpected vector count");
+ASSERT(ADDR(.vectors) == 0x20000000, "recovery vector base changed");
+ASSERT(_ramtext_end <= ORIGIN(RECOVERY) + LENGTH(RECOVERY), "recovery RAM overflow");
+ASSERT((_data_load & 3) == 0, "data load address must be word aligned");
+ASSERT((_ramtext_load & 3) == 0, "RAM code load address must be word aligned");
+ASSERT((_stack_top & 15) == 0, "kernel stack must be 16-byte aligned");
+ASSERT(ORIGIN(STACK) >= ORIGIN(RECOVERY) + LENGTH(RECOVERY), "stack overlaps recovery RAM");
+ASSERT(ORIGIN(RAM) >= _stack_top, "kernel RAM overlaps stack");
+ASSERT(ORIGIN(RAM) + LENGTH(RAM) <= 0x20008000, "RAM exceeds CH582 capacity");
+ASSERT(ORIGIN(FLASH) + LENGTH(FLASH) <= 0x58AF0, "image exceeds conservative stock bound");
