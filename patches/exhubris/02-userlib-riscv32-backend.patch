+OUTPUT_ARCH(riscv)
+ENTRY(_start)
+SECTIONS {
+    . = 0x10000;
+    .text : { *(.text.start*) KEEP(*(.text.abi_*)) *(.text .text.*) }
+    .rodata : { *(.rodata .rodata.*) }
+    . = ALIGN(4);
+    .data : {
+        __sdata = .;
+        *(.sdata .sdata.* .data .data.*)
+        . = ALIGN(4);
+        __edata = .;
+        __global_pointer$ = __sdata + 0x800;
+    }
+    __sidata = LOADADDR(.data);
+    .bss (NOLOAD) : {
+        __sbss = .;
+        *(.sbss .sbss.* .bss .bss.*)
+        . = ALIGN(4);
+        __ebss = .;
+    }
+    .hubris_abi_version (INFO) : { KEEP(*(.hubris_abi_version)) }
+    /DISCARD/ : { *(.comment .eh_frame .eh_frame.*) }
+}
