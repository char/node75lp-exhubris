+#[no_mangle]
+pub extern "C" fn abi_get_timer() -> u32 {
+    let timer = userlib::sys_get_timer();
+    u32::from(timer.now == 0x1122_3344_5566_7788)
+        & u32::from(timer.alarm == Some((0xaabb_ccdd_eeff_0011, 0x55)))
+}
