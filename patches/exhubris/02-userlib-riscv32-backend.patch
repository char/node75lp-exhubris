new file mode 100644
index 0000000000000000000000000000000000000000..89ce52fd0014b876e714d1d5ae6363a281c0945c
--- /dev/null
+++ b/sys/userlib/src/arch/riscv32.rs
@@ -0,0 +1,392 @@
+use core::arch::global_asm;
+use core::mem::MaybeUninit;
+
+extern "Rust" {
+    fn main() -> !;
+}
+
+global_asm!(r#"
+    .section .text.start,"ax"
+    .globl _start
+    .type _start,@function
+_start:
+    .option push
+    .option norelax
+    la gp, __global_pointer$
+    .option pop
+
+    la t0, __sidata
+    la t1, __sdata
+    la t2, __edata
+1:
+    bgeu t1, t2, 2f
+    lw t3, 0(t0)
+    sw t3, 0(t1)
+    addi t0, t0, 4
+    addi t1, t1, 4
+    j 1b
+2:
+    la t1, __sbss
+    la t2, __ebss
+    li t3, 0
+3:
+    bgeu t1, t2, 4f
+    sw t3, 0(t1)
+    addi t1, t1, 4
+    j 3b
+4:
+    call {main}
+5:
+    j 5b
+    .size _start, .-_start
+"#, main = sym main);
+
+use crate::{
+    AbiLease, BorrowInfo, Lease, LeaseAttributes, Message, MessageOrNotification, ReplyFaultReason,
+    ResponseCode, Sysnum, TaskDeath, TaskId, TimerSettings, Truncated,
+};
+
+#[repr(C)]
+struct AbiRecvMessage {
+    sender: u32,
+    operation_or_notification: u32,
+    sent_length: usize,
+    reply_capacity: usize,
+    lease_count: usize,
+}
+
+#[inline(always)]
+unsafe fn syscall(number: u32, args: [u32; 7]) -> [u32; 6] {
+    let (r0, r1, r2, r3, r4, r5);
+    core::arch::asm!(
+        "ecall",
+        inlateout("a0") args[0] => r0,
+        inlateout("a1") args[1] => r1,
+        inlateout("a2") args[2] => r2,
+        inlateout("a3") args[3] => r3,
+        inlateout("a4") args[4] => r4,
+        inlateout("a5") args[5] => r5,
+        in("a6") args[6],
+        in("a7") number,
+    );
+    [r0, r1, r2, r3, r4, r5]
+}
+
+fn dead(rc: u32) -> Result<(), TaskDeath> {
+    match TaskDeath::try_from(ResponseCode(rc)) {
+        Ok(error) => Err(error),
+        Err(_) => Ok(()),
+    }
+}
+
+pub(crate) fn idle() {
+    core::hint::spin_loop();
+}
+
+pub fn sys_send(
+    target: TaskId,
+    operation: u16,
+    outgoing: &[u8],
+    incoming: &mut [u8],
+    leases: &mut [Lease<'_>],
+) -> Result<(ResponseCode, usize), TaskDeath> {
+    let tidop = (u32::from(target.0) << 16) | u32::from(operation);
+    let out = unsafe {
+        syscall(
+            Sysnum::Send as u32,
+            [
+                tidop,
+                outgoing.as_ptr() as u32,
+                outgoing.len() as u32,
+                incoming.as_mut_ptr() as u32,
+                incoming.len() as u32,
+                leases.as_mut_ptr().cast::<AbiLease>() as u32,
+                leases.len() as u32,
+            ],
+        )
+    };
+    match TaskDeath::try_from(ResponseCode(out[0])) {
+        Ok(error) => Err(error),
+        Err(_) => Ok((ResponseCode(out[0]), out[1] as usize)),
+    }
+}
+
+pub fn sys_send_to_kernel(
+    operation: u16,
+    outgoing: &[u8],
+    incoming: &mut [u8],
+    leases: &mut [Lease<'_>],
+) -> (ResponseCode, usize) {
+    let tidop = (u32::from(TaskId::KERNEL.0) << 16) | u32::from(operation);
+    let out = unsafe {
+        syscall(
+            Sysnum::Send as u32,
+            [
+                tidop,
+                outgoing.as_ptr() as u32,
+                outgoing.len() as u32,
+                incoming.as_mut_ptr() as u32,
+                incoming.len() as u32,
+                leases.as_mut_ptr().cast::<AbiLease>() as u32,
+                leases.len() as u32,
+            ],
+        )
+    };
+    (ResponseCode(out[0]), out[1] as usize)
+}
+
+fn recv(
+    incoming: &mut [MaybeUninit<u8>],
+    notification_mask: u32,
+    from: u32,
+) -> (u32, AbiRecvMessage) {
+    let out = unsafe {
+        syscall(
+            Sysnum::Recv as u32,
+            [
+                incoming.as_mut_ptr().cast::<u8>() as u32,
+                incoming.len() as u32,
+                notification_mask,
+                from,
+                0,
+                0,
+                0,
+            ],
+        )
+    };
+    (
+        out[0],
+        AbiRecvMessage {
+            sender: out[1],
+            operation_or_notification: out[2],
+            sent_length: out[3] as usize,
+            reply_capacity: out[4] as usize,
+            lease_count: out[5] as usize,
+        },
+    )
+}
+
+fn as_message<'a>(incoming: &'a [MaybeUninit<u8>], raw: AbiRecvMessage) -> Message<'a> {
+    let data = if raw.sent_length <= incoming.len() {
+        Ok(unsafe { core::slice::from_raw_parts(incoming.as_ptr().cast::<u8>(), raw.sent_length) })
+    } else {
+        Err(Truncated)
+    };
+    Message {
+        sender: TaskId(raw.sender as u16),
+        operation: raw.operation_or_notification as u16,
+        data,
+        reply_capacity: raw.reply_capacity,
+        lease_count: raw.lease_count,
+    }
+}
+
+pub fn sys_recv(
+    incoming: &mut [MaybeUninit<u8>],
+    notification_mask: u32,
+    from: Option<TaskId>,
+) -> Result<MessageOrNotification<'_>, TaskDeath> {
+    let filter = from.map(|tid| 0x8000_0000 | u32::from(tid.0)).unwrap_or(0);
+    let (rc, raw) = recv(incoming, notification_mask, filter);
+    dead(rc)?;
+    if raw.sender as u16 == u16::from(TaskId::KERNEL) {
+        Ok(MessageOrNotification::Notification(
+            raw.operation_or_notification,
+        ))
+    } else {
+        Ok(MessageOrNotification::Message(as_message(incoming, raw)))
+    }
+}
+
+pub fn sys_recv_msg(
+    incoming: &mut [MaybeUninit<u8>],
+    from: Option<TaskId>,
+) -> Result<Message<'_>, TaskDeath> {
+    match sys_recv(incoming, 0, from)? {
+        MessageOrNotification::Message(message) => Ok(message),
+        MessageOrNotification::Notification(_) => unreachable!(),
+    }
+}
+
+pub fn sys_recv_open(
+    incoming: &mut [MaybeUninit<u8>],
+    notification_mask: u32,
+) -> MessageOrNotification<'_> {
+    let (_, raw) = recv(incoming, notification_mask, 0);
+    if raw.sender as u16 == u16::from(TaskId::KERNEL) {
+        MessageOrNotification::Notification(raw.operation_or_notification)
+    } else {
+        MessageOrNotification::Message(as_message(incoming, raw))
+    }
+}
+
+pub fn sys_recv_msg_open(incoming: &mut [MaybeUninit<u8>]) -> Message<'_> {
+    match sys_recv_open(incoming, 0) {
+        MessageOrNotification::Message(message) => message,
+        MessageOrNotification::Notification(_) => unreachable!(),
+    }
+}
+
+pub fn sys_recv_notification(notification_mask: u32) -> u32 {
+    let mut scratch = [];
+    match sys_recv(&mut scratch, notification_mask, Some(TaskId::KERNEL)) {
+        Ok(MessageOrNotification::Notification(bits)) => bits,
+        Ok(MessageOrNotification::Message(_)) => unreachable!(),
+        Err(_) => unreachable!(),
+    }
+}
+
+pub fn sys_reply(sender: TaskId, code: ResponseCode, message: &[u8]) {
+    unsafe {
+        syscall(
+            Sysnum::Reply as u32,
+            [
+                u32::from(sender.0),
+                code.0,
+                message.as_ptr() as u32,
+                message.len() as u32,
+                0,
+                0,
+                0,
+            ],
+        );
+    }
+}
+
+pub fn sys_reply_fault(sender: TaskId, reason: ReplyFaultReason) {
+    unsafe {
+        syscall(
+            Sysnum::ReplyFault as u32,
+            [u32::from(sender.0), reason as u32, 0, 0, 0, 0, 0],
+        );
+    }
+}
+
+pub fn sys_panic(msg: &[u8]) -> ! {
+    unsafe {
+        syscall(
+            Sysnum::Panic as u32,
+            [msg.as_ptr() as u32, msg.len() as u32, 0, 0, 0, 0, 0],
+        );
+    }
+    loop {
+        core::hint::spin_loop();
+    }
+}
+
+pub fn sys_set_timer(deadline: Option<u64>, notifications: u32) {
+    let value = deadline.unwrap_or(0);
+    unsafe {
+        syscall(
+            Sysnum::SetTimer as u32,
+            [
+                deadline.is_some() as u32,
+                value as u32,
+                (value >> 32) as u32,
+                notifications,
+                0,
+                0,
+                0,
+            ],
+        );
+    }
+}
+
+pub fn sys_get_timer() -> TimerSettings {
+    let out = unsafe { syscall(Sysnum::GetTimer as u32, [0; 7]) };
+    TimerSettings {
+        now: u64::from(out[0]) | (u64::from(out[1]) << 32),
+        alarm: if out[2] != 0 {
+            Some((u64::from(out[3]) | (u64::from(out[4]) << 32), out[5]))
+        } else {
+            None
+        },
+    }
+}
+
+pub fn sys_enable_irq(bits: u32) {
+    unsafe {
+        syscall(Sysnum::IrqControl as u32, [bits, 1, 0, 0, 0, 0, 0]);
+    }
+}
+
+pub fn sys_enable_irq_and_clear_pending(bits: u32) {
+    unsafe {
+        syscall(Sysnum::IrqControl as u32, [bits, 3, 0, 0, 0, 0, 0]);
+    }
+}
+
+pub fn sys_borrow_read(
+    lender: TaskId,
+    index: usize,
+    offset: usize,
+    dest: &mut [u8],
+) -> Option<usize> {
+    let out = unsafe {
+        syscall(
+            Sysnum::BorrowRead as u32,
+            [
+                u32::from(lender.0),
+                index as u32,
+                offset as u32,
+                dest.as_mut_ptr() as u32,
+                dest.len() as u32,
+                0,
+                0,
+            ],
+        )
+    };
+    if out[0] == 0 {
+        Some(out[1] as usize)
+    } else {
+        None
+    }
+}
+
+pub fn sys_borrow_write(lender: TaskId, index: usize, offset: usize, src: &[u8]) -> Option<usize> {
+    let out = unsafe {
+        syscall(
+            Sysnum::BorrowWrite as u32,
+            [
+                u32::from(lender.0),
+                index as u32,
+                offset as u32,
+                src.as_ptr() as u32,
+                src.len() as u32,
+                0,
+                0,
+            ],
+        )
+    };
+    if out[0] == 0 {
+        Some(out[1] as usize)
+    } else {
+        None
+    }
+}
+
+pub fn sys_borrow_info(lender: TaskId, index: usize) -> Option<BorrowInfo> {
+    let out = unsafe {
+        syscall(
+            Sysnum::BorrowInfo as u32,
+            [u32::from(lender.0), index as u32, 0, 0, 0, 0, 0],
+        )
+    };
+    if out[0] == 0 {
+        Some(BorrowInfo {
+            atts: LeaseAttributes::from_bits_truncate(out[1]),
+            len: out[2] as usize,
+        })
+    } else {
+        None
+    }
+}
+
+pub fn sys_post(task: TaskId, notifications: u32) -> Result<(), TaskDeath> {
+    dead(unsafe {
+        syscall(
+            Sysnum::Post as u32,
+            [u32::from(task.0), notifications, 0, 0, 0, 0, 0],
+        )[0]
+    })
+}
