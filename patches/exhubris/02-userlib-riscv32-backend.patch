+#![no_std]
+#![no_main]
+
+use core::mem::MaybeUninit;
+use userlib as _;
+use userlib::{MessageOrNotification, TaskId};
+
+#[export_name = "main"]
+fn main() -> ! {
+    loop {
+        core::hint::spin_loop();
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn abi_recv_message() -> u32 {
+    let mut incoming = [MaybeUninit::uninit(); 4];
+    match userlib::sys_recv(&mut incoming, 0x20, Some(TaskId::gen0(3))) {
+        Ok(MessageOrNotification::Message(message)) => {
+            u32::from(u16::from(message.sender) == 7)
+                & u32::from(message.operation == 0x1234)
+                & u32::from(matches!(message.data, Ok(bytes) if bytes == [0x41, 0x42]))
+                & u32::from(message.reply_capacity == 8)
+                & u32::from(message.lease_count == 1)
+        }
+        _ => 0,
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn abi_recv_notification() -> u32 {
+    userlib::sys_recv_notification(0x40)
+}
+
+#[no_mangle]
+pub extern "C" fn abi_recv_death() -> u32 {
+    let mut incoming = [];
+    match userlib::sys_recv(&mut incoming, 0, Some(TaskId::gen0(3))) {
+        Err(error) => {
+            let updated = TaskId::gen0(3).with_generation(error.new_generation());
+            u32::from(u16::from(updated) >> 10)
+        }
+        _ => 0,
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn abi_recv_truncated() -> u32 {
+    let mut incoming = [MaybeUninit::uninit(); 1];
+    match userlib::sys_recv(&mut incoming, 0, None) {
+        Ok(MessageOrNotification::Message(message)) => u32::from(message.data.is_err()),
+        _ => 0,
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn abi_borrow_info_success() -> u32 {
+    match userlib::sys_borrow_info(TaskId::gen0(5), 2) {
+        Some(info) => u32::from(info.atts.bits() == 3) & u32::from(info.len == 0x1234),
+        None => 0,
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn abi_borrow_info_failure() -> u32 {
+    u32::from(userlib::sys_borrow_info(TaskId::gen0(5), 2).is_none())
+}
