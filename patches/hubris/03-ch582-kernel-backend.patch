new file mode 100644
index 0000000000000000000000000000000000000000..c6e15a639dff5e161f2265b53bbb0c46ab44a4ae
--- /dev/null
+++ b/sys/kern/src/arch/ch582/pmp.rs
@@ -0,0 +1,98 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub struct Region {
+    pub address: u32,
+    pub config: u8,
+}
+
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub enum InvalidRegion {
+    Size,
+    Alignment,
+    Overflow,
+    Permissions,
+}
+
+pub const fn encode(
+    base: u32,
+    size: u32,
+    permissions: u8,
+) -> Result<Region, InvalidRegion> {
+    if size < 4 || !size.is_power_of_two() {
+        return Err(InvalidRegion::Size);
+    }
+    if base & (size - 1) != 0 {
+        return Err(InvalidRegion::Alignment);
+    }
+    if base.checked_add(size).is_none() {
+        return Err(InvalidRegion::Overflow);
+    }
+    if permissions & !7 != 0 || permissions & 3 == 2 {
+        return Err(InvalidRegion::Permissions);
+    }
+    Ok(if size == 4 {
+        Region {
+            address: base >> 2,
+            config: 0x10 | permissions,
+        }
+    } else {
+        Region {
+            address: (base >> 2) | ((size >> 3) - 1),
+            config: 0x18 | permissions,
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn documented_na4_and_napot_encodings() {
+        assert_eq!(
+            encode(0x20000000, 4, 3),
+            Ok(Region {
+                address: 0x08000000,
+                config: 0x13
+            })
+        );
+        assert_eq!(
+            encode(0x20001000, 4096, 3),
+            Ok(Region {
+                address: 0x080005ff,
+                config: 0x1b
+            })
+        );
+        assert_eq!(
+            encode(0x14000, 1024, 5),
+            Ok(Region {
+                address: 0x507f,
+                config: 0x1d
+            })
+        );
+        assert_eq!(
+            encode(0, 32, 0),
+            Ok(Region {
+                address: 3,
+                config: 0x18
+            })
+        );
+    }
+
+    #[test]
+    fn rejects_unrepresentable_or_reserved_mappings() {
+        assert_eq!(encode(0, 0, 0), Err(InvalidRegion::Size));
+        assert_eq!(encode(0, 12, 3), Err(InvalidRegion::Size));
+        assert_eq!(encode(0x20000004, 8, 3), Err(InvalidRegion::Alignment));
+        assert_eq!(encode(0xfffffff8, 8, 1), Err(InvalidRegion::Overflow));
+        for permissions in [2, 6, 8, 0x80, 0xff] {
+            assert_eq!(
+                encode(0, 8, permissions),
+                Err(InvalidRegion::Permissions)
+            );
+        }
+    }
+}
