diff --git a/sys/kern/src/arch/ch582.rs b/sys/kern/src/arch/ch582.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7edc159e03a4362e817ce2682ff024f2d637dc0f
--- /dev/null
+++ b/sys/kern/src/arch/ch582.rs
@@ -0,0 +1,333 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+//! CH582 QingKe V4A bootstrap: cooperative scheduling, no external interrupts.
+//! Timers are polled at kernel entry; a task that never traps cannot be preempted.
+
+use crate::{
+    atomic::AtomicExt,
+    descs::RegionAttributes,
+    startup::with_task_table,
+    task::{self, ArchState, Task},
+    time::Timestamp,
+};
+use abi::{FaultInfo, FaultSource, InterruptNum, IrqStatus, UsageError};
+use core::{
+    arch::{asm, global_asm},
+    ptr::read_volatile,
+    sync::atomic::{AtomicBool, AtomicPtr, AtomicU32, Ordering},
+};
+
+mod pmp;
+pub use pmp::Region as RegionDescExt;
+
+#[repr(C)]
+#[derive(Debug, Default)]
+pub struct SavedState {
+    x: [u32; 32],
+    pc: u32,
+    status: u32,
+}
+
+const _: () = assert!(core::mem::offset_of!(SavedState, pc) == 128);
+const _: () = assert!(core::mem::offset_of!(SavedState, status) == 132);
+const _: () = assert!(core::mem::size_of::<SavedState>() == 136);
+
+global_asm!(include_str!("ch582/trap.S"));
+
+impl ArchState for SavedState {
+    fn stack_pointer(&self) -> u32 {
+        self.x[2]
+    }
+    fn arg0(&self) -> u32 {
+        self.x[10]
+    }
+    fn arg1(&self) -> u32 {
+        self.x[11]
+    }
+    fn arg2(&self) -> u32 {
+        self.x[12]
+    }
+    fn arg3(&self) -> u32 {
+        self.x[13]
+    }
+    fn arg4(&self) -> u32 {
+        self.x[14]
+    }
+    fn arg5(&self) -> u32 {
+        self.x[15]
+    }
+    fn arg6(&self) -> u32 {
+        self.x[16]
+    }
+    fn syscall_descriptor(&self) -> u32 {
+        self.x[17]
+    }
+    fn ret0(&mut self, value: u32) {
+        self.x[10] = value;
+    }
+    fn ret1(&mut self, value: u32) {
+        self.x[11] = value;
+    }
+    fn ret2(&mut self, value: u32) {
+        self.x[12] = value;
+    }
+    fn ret3(&mut self, value: u32) {
+        self.x[13] = value;
+    }
+    fn ret4(&mut self, value: u32) {
+        self.x[14] = value;
+    }
+    fn ret5(&mut self, value: u32) {
+        self.x[15] = value;
+    }
+}
+
+impl AtomicExt for AtomicBool {
+    type Primitive = bool;
+    fn swap_polyfill(&self, value: bool, ordering: Ordering) -> bool {
+        self.swap(value, ordering)
+    }
+}
+
+#[no_mangle]
+static CURRENT_TASK_PTR: AtomicPtr<Task> =
+    AtomicPtr::new(core::ptr::null_mut());
+static CYCLES_PER_TICK: AtomicU32 = AtomicU32::new(0);
+
+pub(crate) unsafe fn set_clock_freq(divisor: u32) {
+    // Do not let inherited MPRV apply user mappings to kernel data accesses.
+    unsafe {
+        asm!("csrc mstatus, {mask}", mask = in(reg) 0x20008u32, options(nostack));
+    }
+    assert!(divisor != 0);
+    CYCLES_PER_TICK.store(divisor, Ordering::Relaxed);
+}
+
+pub fn now() -> Timestamp {
+    let cycles = unsafe {
+        loop {
+            let high = read_volatile(0xe000_f00c as *const u32);
+            let low = read_volatile(0xe000_f008 as *const u32);
+            if read_volatile(0xe000_f00c as *const u32) == high {
+                break (u64::from(high) << 32) | u64::from(low);
+            }
+        }
+    };
+    Timestamp::from(cycles / u64::from(CYCLES_PER_TICK.load(Ordering::Relaxed)))
+}
+
+pub fn reinitialize(task: &mut Task) {
+    let descriptor = task.descriptor();
+    let entry = descriptor.entry_point;
+    let stack = descriptor.initial_stack;
+    assert!(entry & 1 == 0);
+    assert!(stack >= 16 && stack & 15 == 0);
+    assert!(task
+        .region_table()
+        .iter()
+        .any(|r| r.attributes.contains(RegionAttributes::EXECUTE)
+            && r.contains(entry as usize)));
+    assert!(task.region_table().iter().any(|r| r
+        .attributes
+        .contains(RegionAttributes::READ | RegionAttributes::WRITE)
+        && !r
+            .attributes
+            .intersects(RegionAttributes::DEVICE | RegionAttributes::DMA)
+        && r.contains((stack - 16) as usize)
+        && r.contains((stack - 1) as usize)));
+    let saved = task.save_mut();
+    *saved = SavedState::default();
+    saved.x[1] = u32::MAX;
+    saved.x[2] = stack;
+    saved.pc = entry;
+}
+
+pub const fn compute_region_extension_data(
+    base: u32,
+    size: u32,
+    attributes: RegionAttributes,
+) -> RegionDescExt {
+    assert!(attributes.bits() & RegionAttributes::RESERVED.bits() == 0);
+    let permissions = (attributes.bits() & 7) as u8;
+    let end = match base.checked_add(size) {
+        Some(end) => end,
+        None => panic!("CH582 region overflow"),
+    };
+    assert!(
+        permissions == 0
+            || (base >= 0x13000 && end <= 0x58af0)
+            || (base >= 0x20000000 && end <= 0x20008000)
+            || (attributes.contains(RegionAttributes::DEVICE)
+                && base >= 0x40000000
+                && end <= 0x40010000)
+    );
+    match pmp::encode(base, size, permissions) {
+        Ok(region) => region,
+        Err(_) => panic!("invalid CH582 PMP region"),
+    }
+}
+
+pub fn apply_memory_protection(task: &Task) {
+    let mut addresses = [0; 4];
+    let mut config = 0u32;
+    for (i, region) in task.region_table().iter().enumerate() {
+        let encoded = compute_region_extension_data(
+            region.base,
+            region.size,
+            region.attributes,
+        );
+        assert_eq!(encoded, region.arch_data);
+        addresses[i] = encoded.address;
+        config |= u32::from(encoded.config) << (i * 8);
+    }
+    unsafe {
+        let old: u32;
+        asm!("csrr {old}, pmpcfg0", old = out(reg) old, options(nostack));
+        assert_eq!(old & 0x80808080, 0, "inherited locked PMP entries");
+        asm!(
+            "csrw pmpcfg0, zero",
+            "csrw pmpaddr0, {a0}", "csrw pmpaddr1, {a1}",
+            "csrw pmpaddr2, {a2}", "csrw pmpaddr3, {a3}",
+            "csrw pmpcfg0, {config}",
+            "fence.i",
+            a0 = in(reg) addresses[0], a1 = in(reg) addresses[1],
+            a2 = in(reg) addresses[2], a3 = in(reg) addresses[3],
+            config = in(reg) config, options(nostack),
+        );
+        let (actual, a0, a1, a2, a3): (u32, u32, u32, u32, u32);
+        asm!(
+            "csrr {config}, pmpcfg0",
+            "csrr {a0}, pmpaddr0", "csrr {a1}, pmpaddr1",
+            "csrr {a2}, pmpaddr2", "csrr {a3}, pmpaddr3",
+            config = out(reg) actual, a0 = out(reg) a0, a1 = out(reg) a1,
+            a2 = out(reg) a2, a3 = out(reg) a3, options(nostack),
+        );
+        assert_eq!(actual, config, "PMP configuration readback");
+        assert_eq!([a0, a1, a2, a3], addresses, "PMP address readback");
+    }
+}
+
+/// `task` must belong to the initialized task table and outlive its next trap.
+pub unsafe fn set_current_task(task: &Task) {
+    CURRENT_TASK_PTR.store(
+        crate::startup::task_pointer(usize::from(task.descriptor().index)),
+        Ordering::Relaxed,
+    );
+    crate::profiling::event_context_switch(usize::from(
+        task.descriptor().index,
+    ));
+}
+
+pub fn start_first_task(_: u32, task: &Task) -> ! {
+    unsafe extern "C" {
+        fn ch582_trap_entry();
+        fn ch582_restore(state: *const SavedState) -> !;
+    }
+    unsafe {
+        let entry = ch582_trap_entry as *const () as usize;
+        let actual: usize;
+        // mscratch is zero in the kernel; a nested trap must never use a task stack.
+        asm!(
+            "csrci mstatus, 8", "csrw mscratch, zero",
+            "csrw 0x804, zero", "csrw mtvec, {entry}",
+            "csrr {actual}, mtvec",
+            entry = in(reg) entry, actual = out(reg) actual,
+            options(nostack),
+        );
+        assert_eq!(actual, entry, "direct trap vector readback");
+        set_current_task(task);
+        ch582_restore(CURRENT_TASK_PTR.load(Ordering::Relaxed).cast())
+    }
+}
+
+#[no_mangle]
+unsafe extern "C" fn ch582_handle_trap(current: *mut Task) -> *mut Task {
+    let (cause, value): (u32, u32);
+    unsafe {
+        asm!("csrr {cause}, mcause", "csrr {value}, mtval",
+        cause = out(reg) cause, value = out(reg) value, options(nostack));
+    }
+    assert_eq!(current, CURRENT_TASK_PTR.load(Ordering::Relaxed));
+    let (index, number) = {
+        let task = unsafe { &mut *current };
+        assert_eq!(task.save().status & 0x1800, 0, "machine-mode trap");
+        assert_eq!(cause & 0x80000000, 0, "unexpected CH582 interrupt");
+        task.update_stack_watermark();
+        (
+            usize::from(task.descriptor().index),
+            task.save().syscall_descriptor(),
+        )
+    };
+    if cause == 8 {
+        let saved = unsafe { &mut *current }.save_mut();
+        saved.pc = saved.pc.checked_add(4).expect("ECALL PC overflow");
+        with_task_table(|tasks| {
+            let _ = task::process_timers(tasks, now());
+        });
+        unsafe {
+            crate::syscalls::syscall_entry(number, current);
+        }
+        // Honor the dispatcher's choice among peers, but not over a higher-priority timer wakeup.
+        let previous = unsafe { &*CURRENT_TASK_PTR.load(Ordering::Relaxed) }
+            .descriptor()
+            .index;
+        with_task_table(|tasks| {
+            let next = task::select(usize::from(previous), tasks);
+            if next
+                .priority()
+                .is_more_important_than(tasks[usize::from(previous)].priority())
+            {
+                apply_memory_protection(next);
+                unsafe {
+                    set_current_task(next);
+                }
+            }
+        });
+    } else {
+        let fault = match cause {
+            0 | 1 | 4 | 5 | 6 | 7 => FaultInfo::MemoryAccess {
+                address: Some(value),
+                source: FaultSource::User,
+            },
+            2 => FaultInfo::IllegalInstruction,
+            _ => FaultInfo::InvalidOperation(cause),
+        };
+        with_task_table(|tasks| {
+            let next = match task::force_fault(tasks, index, fault) {
+                task::NextTask::Specific(i) => &tasks[i],
+                task::NextTask::Other => task::select(index, tasks),
+                task::NextTask::Same => {
+                    panic!("faulted task selected for return")
+                }
+            };
+            assert!(!core::ptr::eq(next, current));
+            apply_memory_protection(next);
+            unsafe {
+                set_current_task(next);
+            }
+        });
+    }
+    CURRENT_TASK_PTR.load(Ordering::Relaxed)
+}
+
+pub fn enable_irq(_: u32, _: bool) -> Result<(), UsageError> {
+    Err(UsageError::NoIrq)
+}
+pub fn disable_irq(_: u32, _: bool) -> Result<(), UsageError> {
+    Err(UsageError::NoIrq)
+}
+pub fn irq_status(_: u32) -> Result<IrqStatus, UsageError> {
+    Err(UsageError::NoIrq)
+}
+pub fn pend_software_irq(_: InterruptNum) -> Result<(), UsageError> {
+    Err(UsageError::NoIrq)
+}
+
+pub fn reset() -> ! {
+    unsafe extern "C" {
+        fn ch582_reset() -> !;
+    }
+    unsafe { ch582_reset() }
+}
