index 0000000000000000000000000000000000000000..3e5d2c6b537dd521c83f91c2ed1ba456ca176dc0
--- /dev/null
+++ b/sys/kern/src/arch/ch582/trap.S
@@ -0,0 +1,126 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+.section .text.ch582_trap, "ax", @progbits
+.balign 4
+.global ch582_trap_entry
+.type ch582_trap_entry,@function
+ch582_trap_entry:
+    csrrw t0, mscratch, t0
+    beqz t0, ch582_trap_fail
+    sw t1, 24(t0)
+    csrrw t1, mscratch, zero
+    sw t1, 20(t0)
+    sw x1, 4(t0)
+    sw x2, 8(t0)
+    sw x3, 12(t0)
+    sw x4, 16(t0)
+    sw x7, 28(t0)
+    sw x8, 32(t0)
+    sw x9, 36(t0)
+    sw x10, 40(t0)
+    sw x11, 44(t0)
+    sw x12, 48(t0)
+    sw x13, 52(t0)
+    sw x14, 56(t0)
+    sw x15, 60(t0)
+    sw x16, 64(t0)
+    sw x17, 68(t0)
+    sw x18, 72(t0)
+    sw x19, 76(t0)
+    sw x20, 80(t0)
+    sw x21, 84(t0)
+    sw x22, 88(t0)
+    sw x23, 92(t0)
+    sw x24, 96(t0)
+    sw x25, 100(t0)
+    sw x26, 104(t0)
+    sw x27, 108(t0)
+    sw x28, 112(t0)
+    sw x29, 116(t0)
+    sw x30, 120(t0)
+    sw x31, 124(t0)
+    csrr t1, mepc
+    sw t1, 128(t0)
+    csrr t1, mstatus
+    sw t1, 132(t0)
+.option push
+.option norelax
+    la sp, _stack_top
+    la gp, __global_pointer$
+.option pop
+    li tp, 0
+    mv a0, t0
+    call ch582_handle_trap
+    j ch582_restore
+.size ch582_trap_entry, .-ch582_trap_entry
+
+.global ch582_restore
+.type ch582_restore,@function
+ch582_restore:
+    mv t0, a0
+    lw t1, 128(t0)
+    csrw mepc, t1
+    /* U-mode, MPRV off, interrupts off: this backend is cooperative. */
+    csrw mstatus, zero
+    csrw mscratch, t0
+    lw x1, 4(t0)
+    lw x2, 8(t0)
+    lw x3, 12(t0)
+    lw x4, 16(t0)
+    lw x6, 24(t0)
+    lw x7, 28(t0)
+    lw x8, 32(t0)
+    lw x9, 36(t0)
+    lw x10, 40(t0)
+    lw x11, 44(t0)
+    lw x12, 48(t0)
+    lw x13, 52(t0)
+    lw x14, 56(t0)
