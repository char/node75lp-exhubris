+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+//! Compile-only RV32 backend, for `--features riscv32-stub`.
+//!
+//! This exists so the architecture-neutral kernel can be built for
+//! `riscv32imac-unknown-none-elf` before a real RISC-V backend is written. It
+//! implements *no* hardware behavior: everything that would start, switch,
+//! protect, or time a task panics, so a kernel built with this feature cannot
+//! boot. It is only meaningful as a typecheck of the portable kernel.
+
+use crate::{
+    atomic::AtomicExt,
+    descs::RegionAttributes,
+    task::{ArchState, Task},
+    time::Timestamp,
+};
+use abi::{InterruptNum, IrqStatus, UsageError};
+use core::sync::atomic::{AtomicBool, Ordering};
+
+/// Stand-in for a real PMP encoding.
+#[derive(Copy, Clone, Debug)]
+pub struct RegionDescExt;
+
+pub const fn compute_region_extension_data(
+    _base: u32,
+    _size: u32,
+    _attributes: RegionAttributes,
+) -> RegionDescExt {
+    RegionDescExt
+}
+
+/// RV32 integer registers in psABI numbering.
+///
+/// The portable kernel only needs the syscall argument registers `a0`-`a6`, the
+/// return registers `a0`-`a5`, the syscall number in `a7`, and the stack
+/// pointer, all of which have their standard psABI indexes here.
+#[derive(Debug, Default)]
+pub struct SavedState {
+    x: [u32; 32],
+}
+
+impl ArchState for SavedState {
+    fn stack_pointer(&self) -> u32 {
+        self.x[2]
+    }
+    fn arg0(&self) -> u32 {
+        self.x[10]
+    }
+    fn arg1(&self) -> u32 {
+        self.x[11]
+    }
+    fn arg2(&self) -> u32 {
+        self.x[12]
+    }
+    fn arg3(&self) -> u32 {
+        self.x[13]
+    }
+    fn arg4(&self) -> u32 {
+        self.x[14]
+    }
+    fn arg5(&self) -> u32 {
+        self.x[15]
+    }
+    fn arg6(&self) -> u32 {
+        self.x[16]
+    }
+    fn syscall_descriptor(&self) -> u32 {
+        self.x[17]
+    }
+    fn ret0(&mut self, value: u32) {
+        self.x[10] = value;
+    }
+    fn ret1(&mut self, value: u32) {
+        self.x[11] = value;
+    }
+    fn ret2(&mut self, value: u32) {
+        self.x[12] = value;
+    }
+    fn ret3(&mut self, value: u32) {
+        self.x[13] = value;
+    }
+    fn ret4(&mut self, value: u32) {
+        self.x[14] = value;
+    }
+    fn ret5(&mut self, value: u32) {
+        self.x[15] = value;
+    }
+}
+
+impl AtomicExt for AtomicBool {
+    type Primitive = bool;
+    fn swap_polyfill(&self, value: bool, ordering: Ordering) -> bool {
+        self.swap(value, ordering)
+    }
+}
