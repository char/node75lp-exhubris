+pub fn start_first_task(_tick_divisor: u32, _task: &Task) -> ! {
+    panic!()
+}
+
+pub fn enable_irq(
+    _irq: u32,
+    _also_clear_pending: bool,
+) -> Result<(), UsageError> {
+    panic!()
+}
+
+pub fn disable_irq(
